---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

interface Props {
  project: CollectionEntry<"work">
  mediaQuery: string
}

const { project, mediaQuery } = Astro.props
const { data, id } = project
---

<a href={`/work/${id}`} class="w-full" data-astro-prefetch transition:persist>
  {data.card.type === "video" ? (
    <video
      data-work-card-video
      class="animate-fadeIn mx-auto h-auto max-h-[50vh] max-w-full w-auto rounded-lg opacity-100 transition-opacity duration-300 hover:opacity-80"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      transition:name={id}
    >
      <source src={data.card.src} type="video/mp4" media={mediaQuery} />
    </video>
  ) : (
    <Image
      src={data.card.src}
      alt={data.card.alt || ""}
      class="animate-fadeIn max-h-[50vh] rounded-lg opacity-100 transition-opacity duration-300 hover:opacity-80"
      transition:name={id}
    />
  )}
  <div class="mt-2 flex items-start justify-between gap-4">
    <div class="flex min-w-0 flex-1 flex-col text-sm leading-5 transition-transform duration-500 hover:scale-105">
      <span class="font-medium wrap-break-word whitespace-normal">{data.title}</span>
      <span class="font-mono text-[11px] tracking-[0.08em] wrap-break-word whitespace-normal text-neutral-500 uppercase">
        {data.caption}
      </span>
    </div>
  </div>
</a>
